<?xml version="1.0" encoding="UTF-8"?>
 
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
 
<BorderPane maxHeight="-Infinity"

            maxWidth="-Infinity"

            minHeight="-Infinity"

            minWidth="-Infinity"

            prefHeight="400.0"

            prefWidth="600.0"

            xmlns="http://javafx.com/javafx/21.0.1"

            xmlns:fx="http://javafx.com/fxml/1"

            fx:controller="org.nacli.controller.MenuPrincipalController">
 
    <top>
<Label text="nacli-Libreria-App" BorderPane.alignment="CENTER" />
</top>
 
    <center>
<VBox prefHeight="277.0"

              prefWidth="384.0"

              spacing="15.0"

              BorderPane.alignment="CENTER">
 
            <children>
 
                <Button mnemonicParsing="false"

                        onAction="#handleClientes"

                        prefHeight="40.0"

                        prefWidth="220.0"

                        text="Clientes" />
 
                <Button mnemonicParsing="false"

                        onAction="#handleAutores"

                        prefHeight="40.0"

                        prefWidth="220.0"

                        text="Autores" />
 
                <Button mnemonicParsing="false"

                        onAction="#handleNoDisponible"

                        prefHeight="40.0"

                        prefWidth="220.0"

                        text="Categorias" />
 
                <Button mnemonicParsing="false"

                        onAction="#handleNoDisponible"

                        prefHeight="40.0"

                        prefWidth="220.0"

                        text="Editoriales" />
 
                <Button mnemonicParsing="false"

                        onAction="#handleSalir"

                        prefHeight="40.0"

                        prefWidth="220.0"

                        text="salir" />
 
            </children>
</VBox>
</center>
 
</BorderPane>
 
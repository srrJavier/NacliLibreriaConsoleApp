<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.nacli.controller.CategoriaFXController">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
   <left>
      <VBox minHeight="300.0" minWidth="300.0" prefHeight="200.0" prefWidth="100.0" spacing="10.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets right="20.0" />
         </padding>
         <children>
            <Label text="Registrar Categoria" />
            <TextField fx:id="txtNombre" promptText="Nombre Categoria" />
            <HBox prefHeight="100.0" prefWidth="200.0" spacing="10.0">
               <children>
                  <Button fx:id="handleGuardar" mnemonicParsing="false" onAction="#handleGuardar" prefWidth="120.0" text="Guardar" />
                  <Button fx:id="handleLimpiar" mnemonicParsing="false" onAction="#handleLimpiar" prefWidth="120.0" text="Limpiar" />
               </children>
            </HBox>
            <HBox prefHeight="100.0" prefWidth="200.0">
               <children>
                  <Label fx:id="lblMensaje" text="Mensaje" />
               </children>
            </HBox>
         </children>
      </VBox>
   </left>
   <center>
      <VBox prefHeight="200.0" prefWidth="100.0" spacing="10.0" BorderPane.alignment="CENTER">
         <children>
            <Label style="-fx-font-size: 18; -fx-font-weight: bold;" text="Lista de categorias" />
            <TableView fx:id="tablaCategoria" prefHeight="200.0" prefWidth="200.0">
              <columns>
                <TableColumn fx:id="colnombreCategoria" prefWidth="200.0" text="Nombre De Las Categorias" />
              </columns>
            </TableView>
            <HBox prefHeight="100.0" prefWidth="200.0" spacing="10.0">
               <children>
                  <Button fx:id="handleActualizar" mnemonicParsing="false" onAction="#handleActualizar" text="Actualizar Tabla" />
                  <Button fx:id="handleVolver" mnemonicParsing="false" onAction="#handleVolver" text="Volver al Menú" />
               </children>
            </HBox>
         </children>
      </VBox>
   </center>
</BorderPane>
